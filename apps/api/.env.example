# Copy to .env for local development (docker-compose reads this file).
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy@postgres:5432/fantasy_baseball
REDIS_URL=redis://redis:6379/0

# Generate a real secret for anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
